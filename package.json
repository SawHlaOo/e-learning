{
  "name": "python-learning-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "vercel-build": "npm install --workspace frontend --no-audit --no-fund && npm run prisma:generate && npm run typecheck:backend && npm run build --workspace frontend",
    "typecheck:backend": "tsc -p backend/tsconfig.json && tsc -p backend/prisma/tsconfig.json",
    "start": "npm run start --workspace backend",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace backend",
    "prisma:seed": "npm run prisma:seed --workspace backend",
    "prisma:studio": "npm run prisma:studio --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
